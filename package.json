{
  "name": "qa-ui-cypress",
  "version": "1.0.0",
  "private": true,
  "description": "Cypress end-to-end test framework with page abstractions, validated runtime configuration, and CI diagnostics.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "cypress run",
    "test:chrome": "cypress run --browser chrome",
    "test:electron": "cypress run --browser electron",
    "test:login": "cypress run --spec cypress/e2e/login.cy.js",
    "cypress:open": "cypress open",
    "cypress:verify": "cypress verify",
    "config:check": "node -e \"require('./cypress.config.js')\""
  },
  "license": "MIT",
  "devDependencies": {
    "cypress": "^15.21.1"
  }
}
